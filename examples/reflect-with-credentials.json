{
  "version": 1,
  "resource": "https://api.meridian-ledger.example/v2/me",
  "description": "The critical case. The server echoes whatever arrives in Origin and sets Access-Control-Allow-Credentials: true, with no Vary: Origin and wildcards on the pre-flight.",
  "trustedOrigins": ["https://dashboard.meridian-ledger.example"],
  "authenticated": true,
  "observations": [
    {
      "requestOrigin": "https://dashboard.meridian-ledger.example",
      "method": "GET",
      "status": 200,
      "requestHeaders": { "Cookie": "sid=synthetic" },
      "responseHeaders": {
        "content-type": "application/json",
        "access-control-allow-origin": "https://dashboard.meridian-ledger.example",
        "access-control-allow-credentials": "true"
      },
      "note": "baseline"
    },
    {
      "requestOrigin": "https://probe.example",
      "method": "GET",
      "status": 200,
      "requestHeaders": { "Cookie": "sid=synthetic" },
      "responseHeaders": {
        "content-type": "application/json",
        "access-control-allow-origin": "https://probe.example",
        "access-control-allow-credentials": "true"
      },
      "note": "wholly unrelated origin, echoed back"
    },
    {
      "requestOrigin": "https://unrelated-second.example",
      "method": "GET",
      "status": 200,
      "requestHeaders": { "Cookie": "sid=synthetic" },
      "responseHeaders": {
        "content-type": "application/json",
        "access-control-allow-origin": "https://unrelated-second.example",
        "access-control-allow-credentials": "true"
      },
      "note": "a second unrelated origin, which confirms reflection rather than a one-entry allowlist"
    },
    {
      "requestOrigin": "null",
      "method": "GET",
      "status": 200,
      "requestHeaders": { "Cookie": "sid=synthetic" },
      "responseHeaders": {
        "content-type": "application/json",
        "access-control-allow-origin": "null",
        "access-control-allow-credentials": "true"
      },
      "note": "null origin echoed too"
    },
    {
      "requestOrigin": "http://dashboard.meridian-ledger.example",
      "method": "GET",
      "status": 200,
      "requestHeaders": { "Cookie": "sid=synthetic" },
      "responseHeaders": {
        "content-type": "application/json",
        "access-control-allow-origin": "http://dashboard.meridian-ledger.example",
        "access-control-allow-credentials": "true"
      },
      "note": "scheme is not checked"
    },
    {
      "requestOrigin": "https://dashboard.meridian-ledger.example:1337",
      "method": "GET",
      "status": 200,
      "requestHeaders": { "Cookie": "sid=synthetic" },
      "responseHeaders": {
        "content-type": "application/json",
        "access-control-allow-origin": "https://dashboard.meridian-ledger.example:1337",
        "access-control-allow-credentials": "true"
      },
      "note": "port is not checked either"
    },
    {
      "requestOrigin": "https://probe.example",
      "method": "OPTIONS",
      "status": 204,
      "requestHeaders": {
        "Access-Control-Request-Method": "PUT",
        "Access-Control-Request-Headers": "authorization,content-type"
      },
      "responseHeaders": {
        "access-control-allow-origin": "https://probe.example",
        "access-control-allow-credentials": "true",
        "access-control-allow-methods": "*",
        "access-control-allow-headers": "*",
        "access-control-max-age": "86400"
      },
      "note": "wildcards on a credentialed pre-flight, which Fetch reads literally"
    }
  ]
}
